{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PatchMindAIDb": "Data Source=/home/site/wwwroot/data/patchmindai-production.db"
  },
  "AzureOpenAI": {
    "Endpoint": "https://YOUR-PRODUCTION-OPENAI.openai.azure.com/",
    "DeploymentName": "YOUR_PRODUCTION_DEPLOYMENT",
    "Model": "gpt-4o",
    "ApiKey": "",
    "UseManagedIdentity": true,
    "ApiVersion": ""
  },
  "AzureSearch": {
    "Endpoint": "https://YOUR-PRODUCTION-SEARCH.search.windows.net",
    "IndexName": "patchmind-cve-production",
    "ApiKey": "",
    "UseManagedIdentity": true,
    "SourceIdField": "id",
    "ContentField": "content",
    "TitleField": "title"
  },
  "ServiceBus": {
    "Provider": "AzureServiceBus",
    "FullyQualifiedNamespace": "YOUR-PRODUCTION-SERVICEBUS.servicebus.windows.net",
    "ConnectionString": "",
    "QueueName": "cve-analysis-jobs"
  },
  "Redis": {
    "Provider": "Redis",
    "ConnectionString": "YOUR-PRODUCTION-REDIS.redis.cache.windows.net:6380,password=YOUR_KEY,ssl=True,abortConnect=False",
    "KeyPrefix": "patchmindai-production",
    "JobStatusTtlMinutes": 60,
    "ResultTtlMinutes": 240
  },
  "AgentSettings": {
    "MaxTurns": 8,
    "EnableReflection": true,
    "EnableRag": true,
    "ToolCallDepthLimit": 4,
    "RequireAzurePipeline": true
  },
  "EvaluationSettings": {
    "Enabled": true,
    "MinPassingScore": 0.8
  },
  "AllowedHosts": "*"
}
