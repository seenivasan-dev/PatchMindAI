{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PatchMindAIDb": "Data Source=patchmindai.db"
  },
  "Persistence": {
    "Provider": "EfCore"
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "DeploymentName": "",
    "Model": "gpt-4o",
    "ApiKey": "",
    "UseManagedIdentity": true,
    "ApiVersion": ""
  },
  "AzureSearch": {
    "Endpoint": "",
    "IndexName": "",
    "ApiKey": "",
    "UseManagedIdentity": true,
    "SourceIdField": "id",
    "ContentField": "content",
    "TitleField": ""
  },
  "ServiceBus": {
    "Provider": "InMemory",
    "FullyQualifiedNamespace": "",
    "ConnectionString": "",
    "QueueName": "cve-analysis-jobs"
  },
  "Redis": {
    "Provider": "InMemory",
    "ConnectionString": "localhost:6379,abortConnect=false",
    "KeyPrefix": "patchmindai",
    "JobStatusTtlMinutes": 60,
    "ResultTtlMinutes": 240
  },
  "AgentSettings": {
    "MaxTurns": 8,
    "EnableReflection": true,
    "EnableRag": false,
    "ToolCallDepthLimit": 4
  },
  "EvaluationSettings": {
    "Enabled": true,
    "MinPassingScore": 0.8
  },
  "AllowedHosts": "*"
}
