{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PatchMindAIDb": "Data Source=patchmindai.db"
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "DeploymentName": "",
    "Model": "gpt-4o"
  },
  "ServiceBus": {
    "Provider": "InMemory",
    "FullyQualifiedNamespace": "",
    "QueueName": "cve-analysis-jobs"
  },
  "Redis": {
    "Provider": "InMemory",
    "ConnectionString": "localhost:6379,abortConnect=false",
    "KeyPrefix": "patchmindai",
    "JobStatusTtlMinutes": 60,
    "ResultTtlMinutes": 240
  },
  "AgentSettings": {
    "MaxTurns": 8,
    "EnableReflection": true,
    "EnableRag": false,
    "ToolCallDepthLimit": 4
  },
  "EvaluationSettings": {
    "Enabled": true,
    "MinPassingScore": 0.8
  },
  "PatchMindApi": {
    "BaseUrl": "http://localhost:5101"
  },
  "AllowedHosts": "*"
}
